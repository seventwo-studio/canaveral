{
  "name": "@canaveral/coordination",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./consumer-client": {
      "types": "./dist/src/consumer-client.d.ts",
      "default": "./dist/src/consumer-client.js"
    },
    ".": {
      "types": "./dist/src/consumer-client.d.ts",
      "default": "./dist/src/consumer-client.js"
    },
    "./contracts": {
      "types": "./dist/src/contracts.d.ts",
      "default": "./dist/src/contracts.js"
    },
    "./sdk": {
      "types": "./dist/src/sdk.d.ts",
      "default": "./dist/src/sdk.js"
    },
    "./terminal-sdk": {
      "types": "./dist/src/terminal-sdk.d.ts",
      "default": "./dist/src/terminal-sdk.js"
    },
    "./visual-sdk": {
      "types": "./dist/src/visual-sdk.d.ts",
      "default": "./dist/src/visual-sdk.js"
    },
    "./accessibility-sdk": {
      "types": "./dist/src/accessibility-sdk.d.ts",
      "default": "./dist/src/accessibility-sdk.js"
    }
  },
  "scripts": {
    "build": "tsc && node ../script/prepare_cli.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/*.test.js dist/test/control/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  },
  "files": [
    "dist/src"
  ]
}
