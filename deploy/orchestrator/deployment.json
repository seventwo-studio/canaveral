{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "orchestrator"
  },
  "spec": {
    "replicas": 1,
    "strategy": {
      "type": "Recreate"
    },
    "selector": {
      "matchLabels": {
        "app": "canaveral-orchestrator"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "canaveral-orchestrator"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001,
          "runAsGroup": 10001,
          "fsGroup": 10001,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "orchestrator",
            "image": "canaveral:local",
            "imagePullPolicy": "IfNotPresent",
            "ports": [
              {
                "containerPort": 8765
              }
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              }
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 8765,
                "scheme": "HTTPS"
              },
              "initialDelaySeconds": 2
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 8765,
                "scheme": "HTTPS"
              },
              "initialDelaySeconds": 10
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "volumeMounts": [
              {
                "name": "state",
                "mountPath": "/data"
              },
              {
                "name": "credentials",
                "mountPath": "/run/credentials",
                "readOnly": true
              },
              {
                "name": "tls",
                "mountPath": "/run/tls",
                "readOnly": true
              }
            ],
            "args": [
              "serve",
              "--bind",
              "0.0.0.0",
              "--database",
              "/data/orchestrator.sqlite3",
              "--admin-token-file",
              "/run/credentials/admin.token",
              "--enrollment-token-file",
              "/run/credentials/enrollment.token",
              "--tls-cert-file",
              "/run/tls/server.crt",
              "--tls-key-file",
              "/run/tls/server.key"
            ]
          }
        ],
        "volumes": [
          {
            "name": "state",
            "persistentVolumeClaim": {
              "claimName": "orchestrator-state"
            }
          },
          {
            "name": "credentials",
            "secret": {
              "secretName": "canaveral-credentials",
              "defaultMode": 288
            }
          },
          {
            "name": "tls",
            "secret": {
              "secretName": "canaveral-controller-tls",
              "defaultMode": 288,
              "items": [
                {
                  "key": "tls.crt",
                  "path": "server.crt"
                },
                {
                  "key": "tls.key",
                  "path": "server.key"
                }
              ]
            }
          }
        ]
      }
    }
  }
}
