{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "canaveral"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "orchestrator-state",
        "namespace": "canaveral"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "10Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "orchestrator",
        "namespace": "canaveral"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "canaveral-orchestrator"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "canaveral-orchestrator"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001
            },
            "containers": [
              {
                "name": "orchestrator",
                "image": "canaveral:local",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 8765
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8765
                  },
                  "initialDelaySeconds": 2
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8765
                  },
                  "initialDelaySeconds": 10
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "state",
                    "mountPath": "/data"
                  },
                  {
                    "name": "credentials",
                    "mountPath": "/run/credentials",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "state",
                "persistentVolumeClaim": {
                  "claimName": "orchestrator-state"
                }
              },
              {
                "name": "credentials",
                "secret": {
                  "secretName": "canaveral-credentials",
                  "defaultMode": 288
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "orchestrator",
        "namespace": "canaveral"
      },
      "spec": {
        "selector": {
          "app": "canaveral-orchestrator"
        },
        "ports": [
          {
            "port": 8765,
            "targetPort": 8765
          }
        ]
      }
    }
  ]
}
