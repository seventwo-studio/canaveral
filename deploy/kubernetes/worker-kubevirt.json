{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "canaveral-guests"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "canaveral-worker",
        "namespace": "canaveral-guests"
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {
        "name": "canaveral-worker",
        "namespace": "canaveral-guests"
      },
      "rules": [
        {
          "apiGroups": [
            "kubevirt.io"
          ],
          "resources": [
            "virtualmachines"
          ],
          "verbs": [
            "get",
            "list",
            "create",
            "patch"
          ]
        },
        {
          "apiGroups": [
            "kubevirt.io"
          ],
          "resources": [
            "virtualmachineinstances"
          ],
          "verbs": [
            "get",
            "list"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "persistentvolumeclaims"
          ],
          "verbs": [
            "get",
            "list"
          ]
        },
        {
          "apiGroups": [
            "cdi.kubevirt.io"
          ],
          "resources": [
            "datavolumes/source"
          ],
          "verbs": [
            "create"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "secrets"
          ],
          "verbs": [
            "get",
            "create"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "canaveral-worker",
        "namespace": "canaveral-guests"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "canaveral-worker"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "canaveral-worker",
          "namespace": "canaveral-guests"
        }
      ]
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "canaveral-worker-config",
        "namespace": "canaveral-guests"
      },
      "data": {
        "host.json": "{\n  \"name\": \"kubernetes-pool\",\n  \"provider\": \"kubevirt\",\n  \"namespace\": \"canaveral-guests\",\n  \"capacity\": {\"cpu\": 16, \"memoryMiB\": 32768, \"diskGiB\": 500},\n  \"templates\": [\n    {\"id\": \"linux-server\", \"revision\": \"1\", \"os\": \"linux\", \"arch\": \"amd64\", \"mode\": \"headless\", \"pvc\": \"linux-server-template\", \"minimum\": {\"cpu\": 1, \"memoryMiB\": 1024, \"diskGiB\": 10}},\n    {\"id\": \"linux-desktop\", \"revision\": \"1\", \"os\": \"linux\", \"arch\": \"amd64\", \"mode\": \"desktop\", \"pvc\": \"linux-desktop-template\", \"minimum\": {\"cpu\": 2, \"memoryMiB\": 4096, \"diskGiB\": 32}}\n  ]\n}\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "canaveral-worker",
        "namespace": "canaveral-guests"
      },
      "spec": {
        "clusterIP": "None",
        "selector": {
          "app": "canaveral-worker"
        },
        "ports": [
          {
            "name": "identity",
            "port": 8766,
            "targetPort": 8766
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "canaveral-worker",
        "namespace": "canaveral-guests"
      },
      "spec": {
        "serviceName": "canaveral-worker",
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "canaveral-worker"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "canaveral-worker"
            }
          },
          "spec": {
            "serviceAccountName": "canaveral-worker",
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001
            },
            "containers": [
              {
                "name": "worker",
                "image": "canaveral-kubevirt:local",
                "imagePullPolicy": "IfNotPresent",
                "args": [
                  "--url",
                  "https://orchestrator.canaveral.svc:8765",
                  "host",
                  "--config",
                  "/config/host.json",
                  "--state",
                  "/data",
                  "--enrollment-token-file",
                  "/run/credentials/enrollment.token",
                  "--ca-file",
                  "/run/tls/ca.crt"
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "state",
                    "mountPath": "/data"
                  },
                  {
                    "name": "config",
                    "mountPath": "/config",
                    "readOnly": true
                  },
                  {
                    "name": "credentials",
                    "mountPath": "/run/credentials",
                    "readOnly": true
                  },
                  {
                    "name": "controller-ca",
                    "mountPath": "/run/tls",
                    "readOnly": true
                  }
                ],
                "env": [
                  {
                    "name": "NODE_EXTRA_CA_CERTS",
                    "value": "/run/tls/ca.crt"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "canaveral-worker-config"
                }
              },
              {
                "name": "credentials",
                "secret": {
                  "secretName": "canaveral-enrollment",
                  "defaultMode": 288
                }
              },
              {
                "name": "controller-ca",
                "configMap": {
                  "name": "canaveral-controller-ca"
                }
              }
            ]
          }
        },
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "state"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "1Gi"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
