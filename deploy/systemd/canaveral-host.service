[Unit]
Description=Canaveral VM host agent
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/canaveral
Environment=CANAVERAL_URL=https://canaveral.example.internal
Environment=CANAVERAL_ENROLLMENT_TOKEN_FILE=/etc/canaveral/enrollment.token
ExecStart=/usr/bin/node /opt/canaveral/coordination/dist/src/cli.js host --config /etc/canaveral/host.json --state /var/lib/canaveral/agent
Restart=on-failure
RestartSec=10
UMask=0077
# Leased Android emulators run under detached lease supervisors that must outlive the
# host process: they keep enforcing each lease deadline while the host restarts. The
# default control-group mode would kill every supervisor and emulator on stop or restart.
# Stop signals the host process only; supervisors and native runners keep running.
KillMode=process

[Install]
WantedBy=multi-user.target
