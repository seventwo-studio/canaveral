{
  "name": "android-devices",
  "provider": "android",
  "capacity": {"cpu": 4, "memoryMiB": 8192, "diskGiB": 40},
  "storage": "/var/lib/canaveral/android",
  "androidSDK": "/opt/android-sdk",
  "artifacts": {"development": "/srv/canaveral/apps/development.apk"},
  "pressure": {
    "gatePlacement": false,
    "gateRestart": false,
    "memory": {"psiEnterPercent": 10, "psiExitPercent": 5, "availableEnterPercent": 5, "availableExitPercent": 10},
    "disk": {"enterFreeGiB": 5, "exitFreeGiB": 10},
    "enterSeconds": 10,
    "clearSeconds": 60
  },
  "upkeep": {
    "idleStopSeconds": 0,
    "templates": {"android-phone": {"idleStopSeconds": 3600}}
  },
  "templates": [{"templateFile": "templates/android-phone.json"}]
}
