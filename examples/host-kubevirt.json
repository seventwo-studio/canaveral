{
  "name": "kubernetes-pool",
  "provider": "kubevirt",
  "namespace": "canaveral-guests",
  "capacity": {"cpu": 16, "memoryMiB": 32768, "diskGiB": 500},
  "templates": [
    {"id": "linux-server", "revision": "1", "os": "linux", "arch": "amd64", "mode": "headless", "pvc": "linux-server-template", "minimum": {"cpu": 1, "memoryMiB": 1024, "diskGiB": 10}},
    {"id": "linux-desktop", "revision": "1", "os": "linux", "arch": "amd64", "mode": "desktop", "pvc": "linux-desktop-template", "minimum": {"cpu": 2, "memoryMiB": 4096, "diskGiB": 32}}
  ]
}
