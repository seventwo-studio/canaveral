{
  "name": "ios-devices",
  "provider": "ios",
  "capacity": {"cpu": 4, "memoryMiB": 8192, "diskGiB": 40},
  "storage": "/Users/operator/Library/Application Support/Canaveral/ios",
  "idb": "/opt/homebrew/bin/idb",
  "artifacts": {"development": "/Users/operator/Builds/Development.app"},
  "pressure": {
    "gatePlacement": false,
    "gateRestart": false,
    "memory": {"darwinEnterLevel": "warning"},
    "disk": {"enterFreeGiB": 10, "exitFreeGiB": 20},
    "enterSeconds": 10,
    "clearSeconds": 60
  },
  "upkeep": {"idleStopSeconds": 7200},
  "templates": [{"templateFile": "templates/ios-phone.json"}]
}
