        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "durable": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "InspectionRequest": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "begin"
        }
      },
      "additionalProperties": false
