      "type": "object",
      "required": [
        "type",
        "sessionId",
        "generation",
        "capability"
      ],
      "properties": {
        "type": {
          "const": "ready"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "string",
          "format": "uuid"
        },
        "capability": {
          "type": "string",
          "enum": [
            "pty",
            "display",
            "upload",
            "download",
            "accessibility"
          ]
        }
      },
      "additionalProperties": false
    },
    "WorkerError": {
      "type": "object",
      "required": [
        "type",
        "code",
        "message",
        "outcome"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "enum": [
            "capability_unsupported",
            "session_incomplete",
            "upload_publication_uncertain"
          ]
        },
        "message": {
          "type": "string"
        },
        "outcome": {
          "const": "unknown"
        }
      },
      "additionalProperties": false
    },
    "PtyWrite": {
      "type": "object",
      "required": [
        "action",
        "arguments"
      ],
      "properties": {
        "action": {
          "const": "shell-write"
        },
        "arguments": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 16000,
              "pattern": "^[^\\u0000]*$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "PtyResize": {
      "type": "object",
