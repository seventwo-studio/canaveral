{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:canaveral:session-control:v1",
  "title": "Canaveral session-v1 control envelopes",
  "description": "JSON text control shapes for implemented workers. Validate serialized UTF-8 length separately (16384 bytes), plus direction, stream order, byte totals, digest, authorization and identity bindings. Binary payloads are WebSocket bytes, not base64 JSON. Broker readiness is separate from worker messages. The relay checks object/envelope size and binary direction; it does not enforce every capability schema.",
  "anyOf": [
    {
      "$ref": "#/$defs/Ready"
    },
    {
      "$ref": "#/$defs/WorkerError"
    },
    {
      "$ref": "#/$defs/PtyWrite"
    },
    {
      "$ref": "#/$defs/PtyResize"
    },
    {
      "$ref": "#/$defs/PtyTruncated"
    },
    {
      "$ref": "#/$defs/PtyExited"
    },
    {
      "$ref": "#/$defs/DownloadBegin"
    },
    {
      "$ref": "#/$defs/UploadBegin"
    },
    {
      "$ref": "#/$defs/DownloadSize"
    },
    {
      "$ref": "#/$defs/TransferFinish"
    },
    {
      "$ref": "#/$defs/UploadFinish"
    },
    {
      "$ref": "#/$defs/InspectionRequest"
    },
    {
      "$ref": "#/$defs/InspectionBegin"
    },
    {
      "$ref": "#/$defs/InputControl"
    },
    {
      "$ref": "#/$defs/Ownership"
    },
    {
      "$ref": "#/$defs/ActionReceipt"
    },
    {
      "$ref": "#/$defs/ActionResult"
    },
    {
      "$ref": "#/$defs/Action"
    }
  ],
  "$defs": {
